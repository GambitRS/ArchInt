{
  "version": 1,
  "description": "Database specification for the Hello World API",
  "tables": [
    {
      "name": "User",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "autoIncrement": true
        },
        {
          "name": "name",
          "type": "TEXT",
          "notNull": true
        },
        {
          "name": "email",
          "type": "TEXT",
          "notNull": true,
          "unique": true
        },
        {
          "name": "role",
          "type": "TEXT",
          "notNull": true,
          "default": "user",
          "allowedValues": ["admin", "user"]
        },
        {
          "name": "password",
          "type": "TEXT",
          "notNull": true
        }
      ]
    },
    {
      "name": "Session",
      "columns": [
        { "name": "tokenHash", "type": "TEXT", "primaryKey": true },
        { "name": "userId", "type": "INTEGER", "notNull": true },
        { "name": "expiresAt", "type": "INTEGER", "notNull": true }
      ]
    },
    {
      "name": "Drawing",
      "columns": [
        { "name": "id", "type": "TEXT", "primaryKey": true },
        { "name": "userId", "type": "INTEGER", "notNull": true },
        { "name": "name", "type": "TEXT", "notNull": true },
        { "name": "category", "type": "TEXT", "notNull": true },
        { "name": "document", "type": "TEXT", "notNull": true },
        { "name": "updatedAt", "type": "TEXT", "notNull": true },
        { "name": "revision", "type": "INTEGER", "notNull": true, "default": 1 }
      ]
    },
    {
      "name": "DrawingCreation",
      "columns": [
        { "name": "id", "type": "TEXT", "primaryKey": true },
        { "name": "userId", "type": "INTEGER", "notNull": true },
        { "name": "idempotencyKey", "type": "TEXT", "notNull": true },
        { "name": "drawingId", "type": "TEXT", "notNull": true },
        { "name": "createdAt", "type": "TEXT", "notNull": true }
      ]
    }
  ],
  "relations": [
    {
      "from": { "table": "Session", "column": "userId" },
      "to": { "table": "User", "column": "id" },
      "onDelete": "CASCADE"
    },
    {
      "from": { "table": "Drawing", "column": "userId" },
      "to": { "table": "User", "column": "id" },
      "onDelete": "CASCADE"
    },
    {
      "from": { "table": "DrawingCreation", "column": "userId" },
      "to": { "table": "User", "column": "id" },
      "onDelete": "CASCADE"
    },
    {
      "from": { "table": "DrawingCreation", "column": "drawingId" },
      "to": { "table": "Drawing", "column": "id" },
      "onDelete": "CASCADE"
    }
  ]
}
